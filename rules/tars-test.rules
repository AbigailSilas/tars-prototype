# Test rules for the TARS lab. They carry 'confidence' and 'signature_severity'
# metadata so that the prototype can be tested repeatably.
alert tcp any any -> $HOME_NET any (msg:"TARS TEST id check returned root"; flow:established,to_client; content:"uid=0|28|root|29|"; classtype:bad-unknown; priority:1; metadata:confidence High, signature_severity Major; sid:9000001; rev:1;)
alert dns $HOME_NET any -> any any (msg:"TARS TEST DNS lookup of known bad domain"; dns.query; content:"bad-domain.example"; nocase; classtype:bad-unknown; priority:2; metadata:confidence Medium, signature_severity Minor; sid:9000002; rev:1;)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"TARS TEST ICMP echo from outside"; itype:8; classtype:misc-activity; priority:3; metadata:confidence Low, signature_severity Informational; sid:9000003; rev:1;)
